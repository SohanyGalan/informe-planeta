# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://www.tudominio.com
# ID de editor de AdSense (ca-pub-XXXXXXXXXXXXXXXX). Si está vacío, no se carga el script.
NEXT_PUBLIC_ADSENSE_CLIENT=
# "true" para usar la CMP certificada de Google (AdSense > Privacidad y mensajes) en lugar del aviso propio
NEXT_PUBLIC_USE_GOOGLE_CMP=false
